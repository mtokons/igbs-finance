# Database (PostgreSQL for Vercel / Neon / Supabase, or file:./dev.db for local SQLite)
DATABASE_URL="postgresql://username:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth (Set to your Vercel domain in production, e.g. https://your-project.vercel.app)
NEXTAUTH_URL="https://your-project.vercel.app"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# Bank & Email
CRON_SECRET="generate-another-secure-random-string"
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-google-app-password"
MAIL_FROM_NAME="IGBS e.V. Hamburg"

# GoCardless Bank Account Data (PSD2 - Optional)
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
GOCARDLESS_REDIRECT_URL="https://your-project.vercel.app/api/bank/gocardless/callback"
