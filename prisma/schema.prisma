generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  username           String?   @unique
  emailVerified      DateTime?
  passwordHash       String?
  role               String    @default("TREASURER") // ADMIN, TREASURER, TEACHER, STUDENT, VIEWER
  mustChangePassword Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  auditLogs          AuditLog[]
  teacher            Teacher?
  studentEnrollments CourseEnrollment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id          String   @id @default(cuid())
  fullName    String
  email       String?
  phone       String?
  address     String?
  memberType  String?  // Regular Member, Student Member, Madrasha, All
  ibanLast4   String?
  memberCode  String?  @unique
  monthlyFee  Float
  joinDate    DateTime @default(now())
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membershipPayments MembershipPayment[]
  courseEnrollments  CourseEnrollment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // INCOME, EXPENSE
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  bankTransactions BankTransaction[]
}

model BankTransaction {
  id                   String    @id @default(cuid())
  externalId           String?
  bookingDate          DateTime
  valueDate            DateTime?
  amount               Float
  counterparty         String?
  reference            String?
  source               String    @default("MANUAL") // MANUAL, CSV_IMPORT, GOCARDLESS
  reconciliationStatus String    @default("UNMATCHED") // UNMATCHED, SUGGESTED, MATCHED, IGNORED
  categoryId           String?
  notes                String?
  importHash           String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id])
  membershipPayment  MembershipPayment?
  courseEnrollment   CourseEnrollment?
  coursePayment      CoursePayment?
  salaryPayment      SalaryPayment?
  eventTransaction   EventTransaction?
}

model MembershipPayment {
  id                String    @id @default(cuid())
  memberId          String
  periodYear        Int
  periodMonth       Int
  expectedAmount    Float
  paidAmount        Float     @default(0)
  status            String    @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  bankTransactionId String?   @unique
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@unique([memberId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  semester    String?  @default("Semester 1")
  fee         Float
  teacherId   String?
  schedule    String?
  room        String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments CourseEnrollment[]
  attendances Attendance[]
  evaluations StudentEvaluation[]
}

model CourseEnrollment {
  id                 String    @id @default(cuid())
  courseId           String
  memberId           String?
  userId             String?
  rollNumber         String?   @unique
  studentCode        String?   @unique
  studentType        String    @default("STUDENT_ONLY") // "MEMBER" or "STUDENT_ONLY"
  studentName        String?
  studentEmail       String?
  studentPhone       String?
  guardianName       String?
  guardianPhone      String?
  semester           String?   @default("Semester 1")
  expectedAmount     Float
  paidAmount         Float     @default(0)
  paymentPlan        String    @default("FULL") // "FULL" (1 installment) or "INSTALLMENTS_2" (2 installments)
  installment1Amount Float?
  installment1Status String?   @default("PENDING") // PENDING, PAID, OVERDUE
  installment1PaidAt DateTime?
  installment2Amount Float?
  installment2Status String?   @default("PENDING") // PENDING, PAID, OVERDUE
  installment2PaidAt DateTime?
  status             String    @default("PENDING") // PENDING, PARTIAL, PAID, CANCELLED
  bankTransactionId  String?   @unique
  enrolledAt         DateTime  @default(now())
  paidAt             DateTime?
  notes              String?

  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member          Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction?    @relation(fields: [bankTransactionId], references: [id])
  payments        CoursePayment[]
  attendances     Attendance[]
  evaluations     StudentEvaluation[]

  @@unique([courseId, memberId])
}

model CoursePayment {
  id                String    @id @default(cuid())
  enrollmentId      String
  amount            Float
  paidAt            DateTime  @default(now())
  method            String    @default("BANK") // BANK, CASH, MANUAL
  bankTransactionId String?   @unique
  note              String?
  createdAt         DateTime  @default(now())

  enrollment      CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([enrollmentId])
}

model Teacher {
  id             String   @id @default(cuid())
  userId         String?  @unique
  name           String
  email          String?
  phone          String?
  defaultSalary  Float
  paymentHint    String?
  ibanLast4      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses        Course[]
  salaryPayments SalaryPayment[]
  attendances    Attendance[]
  evaluations    StudentEvaluation[]
}

model Attendance {
  id           String   @id @default(cuid())
  courseId     String
  enrollmentId String
  teacherId    String?
  date         DateTime
  status       String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher      Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([courseId, enrollmentId, date])
  @@index([courseId, date])
  @@index([enrollmentId])
}

model StudentEvaluation {
  id              String   @id @default(cuid())
  courseId        String
  enrollmentId    String
  teacherId       String?
  semester        String   @default("Semester 1")
  evaluationDate  DateTime @default(now())
  quranRecitation Float?   // 0-100 or grade
  tajweed         Float?
  memorization    Float?
  islamicStudies  Float?
  behavior        Float?
  attendanceScore Float?
  totalScore      Float?
  grade           String?  // A+, A, B, C, D, F / Pass, Distinction
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment      CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher         Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([courseId, semester])
  @@index([enrollmentId])
}

model SalaryPayment {
  id                String    @id @default(cuid())
  teacherId         String
  periodYear        Int
  periodMonth       Int
  amount            Float
  status            String    @default("PENDING")
  bankTransactionId String?   @unique
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([periodYear, periodMonth])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  eventDate DateTime
  budget    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions EventTransaction[]
}

model EventTransaction {
  id                String  @id @default(cuid())
  eventId           String
  bankTransactionId String  @unique
  notes             String?

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
}

model BankConnection {
  id              String    @id @default(cuid())
  institutionName String?
  accountId       String?
  requisitionId   String?
  iban            String?
  status          String    @default("PENDING")
  consentExpires  DateTime?
  lastSyncAt      DateTime?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
