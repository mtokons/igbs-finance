generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          String    @default("TREASURER") // ADMIN, TREASURER, VIEWER
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id          String   @id @default(cuid())
  fullName    String
  email       String?
  phone       String?
  ibanLast4   String?
  memberCode  String?  @unique
  monthlyFee  Float
  joinDate    DateTime @default(now())
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membershipPayments MembershipPayment[]
  courseEnrollments  CourseEnrollment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // INCOME, EXPENSE
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  bankTransactions BankTransaction[]
}

model BankTransaction {
  id                   String    @id @default(cuid())
  externalId           String?
  bookingDate          DateTime
  valueDate            DateTime?
  amount               Float
  counterparty         String?
  reference            String?
  source               String    @default("MANUAL") // MANUAL, CSV_IMPORT, GOCARDLESS
  reconciliationStatus String    @default("UNMATCHED") // UNMATCHED, SUGGESTED, MATCHED, IGNORED
  categoryId           String?
  notes                String?
  importHash           String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id])
  membershipPayment  MembershipPayment?
  courseEnrollment   CourseEnrollment?
  coursePayment      CoursePayment?
  salaryPayment      SalaryPayment?
  eventTransaction   EventTransaction?
}

model MembershipPayment {
  id                String    @id @default(cuid())
  memberId          String
  periodYear        Int
  periodMonth       Int
  expectedAmount    Float
  paidAmount        Float     @default(0)
  status            String    @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  bankTransactionId String?   @unique
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@unique([memberId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  fee         Float
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseEnrollment[]
}

model CourseEnrollment {
  id                String    @id @default(cuid())
  courseId          String
  memberId          String?
  studentCode       String?   @unique
  studentName       String?
  studentEmail      String?
  studentPhone      String?
  expectedAmount    Float
  paidAmount        Float     @default(0)
  status            String    @default("PENDING")
  bankTransactionId String?   @unique
  enrolledAt        DateTime  @default(now())
  paidAt            DateTime?
  notes             String?

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member          Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  payments        CoursePayment[]

  @@unique([courseId, memberId])
}

model CoursePayment {
  id                String    @id @default(cuid())
  enrollmentId      String
  amount            Float
  paidAt            DateTime  @default(now())
  method            String    @default("BANK") // BANK, CASH, MANUAL
  bankTransactionId String?   @unique
  note              String?
  createdAt         DateTime  @default(now())

  enrollment      CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([enrollmentId])
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  defaultSalary  Float
  paymentHint    String?
  ibanLast4      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salaryPayments SalaryPayment[]
}

model SalaryPayment {
  id                String    @id @default(cuid())
  teacherId         String
  periodYear        Int
  periodMonth       Int
  amount            Float
  status            String    @default("PENDING")
  bankTransactionId String?   @unique
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([periodYear, periodMonth])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  eventDate DateTime
  budget    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions EventTransaction[]
}

model EventTransaction {
  id                String  @id @default(cuid())
  eventId           String
  bankTransactionId String  @unique
  notes             String?

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
}

model BankConnection {
  id              String    @id @default(cuid())
  institutionName String?
  accountId       String?
  requisitionId   String?
  iban            String?
  status          String    @default("PENDING")
  consentExpires  DateTime?
  lastSyncAt      DateTime?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
