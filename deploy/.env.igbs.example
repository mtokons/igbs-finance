# Copy this file to deploy/.env.igbs ON THE SERVER and fill in real values.
# Never commit real secrets. docker-compose reads it via --env-file.

NEXTAUTH_URL=https://igbs.mysccg.de
# REQUIRED: generate a strong secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-strong-32-char-secret
CRON_SECRET=change-me

# Optional Gmail SMTP (enrollment / invoice emails). Use a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=IGBS e.V. Hamburg
